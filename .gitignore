# Dependencies
node_modules/
.venv/

# Build artifacts
dist/
.cache/
build/

# Environment files (never commit real secrets).
# Ignore .env and all variants (.env.local, .env.production, ...) but keep the
# committed templates (.env.example at any depth).
.env
.env.*
!.env.example
!*.env.example

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Log files
#
# `*.log` bao cả nhật ký chạy tay ở gốc repo — đầu ra của deploy.sh, pytest,
# migration. Không tệp `.log` nào đang được git theo dõi, nên luật này không
# giấu mất thứ gì. Nó có mặt vì lượt xử lý sự cố 12/08/2026 để lại năm tệp như
# vậy ở gốc, và chúng đã sẵn sàng lọt vào commit tiếp theo.
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.pyc
*.pyo
*.pyd

# Git
.gitnexus/

# OS files
.DS_Store
Thumbs.db

# Database files
*.db
*.sqlite
*.sqlite3

# Temporary files
temp/
tmp/
*.tmp

# Video and model files
# ...but keep the directory itself tracked. Docker creates a missing bind-mount
# source as root:root, and the containers run as uid 1000 (appuser) — on Linux
# that makes /dataset unwritable and every upload fails. A committed .gitkeep
# means `git clone` creates the dir owned by the cloning user instead.
dataset/*
!dataset/.gitkeep
*.mp4
*.npz
*.npy
*.mov
*.avi

# Git
.git/

# Google Drive credentials
# Same reasoning as dataset/ above: keep the directory, never its contents
# (credentials.json / token.json stay out of git).
gdrive/*
!gdrive/.gitkeep

# Spreadsheet credentials
SsheetAPI/

#Trained Model
processed/train_utils/outputs
processed/analysis
*.json
processed/splits
*.csv

*.md
*.txt
# TLS certs (self-signed for HTTP/2; use a real cert in prod)
certs/*
!certs/.gitkeep

# SOT — private signing keys must NEVER be committed (public keys in
# app/sot/authorized_keys.json are fine; those are meant to be committed).
sot_private.key
*.key
.voya/
# ...but the public-key allowlist MUST be tracked (overrides the *.json rule
# above); it is the committed root of trust servers verify against.
!backend/app/sot/authorized_keys.json

# Signer identity: which raw names in samples.csv are the SAME PERSON. Owner-
# confirmed, hand-curated, and unreproducible from anything else in the repo.
# The blanket *.json above kept it untracked, and it duly disappeared once
# (2026-07-27 backup was the only survivor) — with an empty mapping every
# spelling variant becomes its own signer and LOSO silently reports a
# signer-independent result it did not measure. It must be versioned.
!config/legacy_signer_mapping.json
!config/legacy_signer_merge.json

# Same story, same blanket rule, second casualty: without this file every class
# created through the app is born with an empty recognition_profile, and every
# split filtered by profile then omits it silently — the class trains nothing
# and nobody is told.
!config/legacy_vocabulary_mapping.json

# Hạt giống bảng đăng ký phương ngữ. Sau khi seed, Postgres là nguồn sự thật;
# file này chỉ còn giá trị lịch sử + để dựng lại một máy từ số không.
!config/dialects.seed.csv

# Local scratch dir for verification logs / throwaway compose overrides.
# Never part of a deploy.
_tmp/

# Database dumps. backup.sql and merge_data.sql were committed in 1be7f25 and
# each carried 6 real user emails plus their bcrypt password hashes, along with
# full users / user_profiles / refresh_tokens rows. Nothing in the repo reads
# them. A dump is production personal data, not fixture data — keep it out.
*.sql
!**/migrations/*.sql
!scripts/*.sql

# Postgres/Redis data directories. This compose uses NAMED volumes, so these
# should not appear in the repo at all — but an older setup (or a hand-run
# container) can leave one behind, and it then shows up as untracked noise that
# a careless `git clean -fd` would delete along with the database inside it.
postgres_data/
pgdata/
redis_data/

# Per-machine allowlist of public hostnames (see deploy/public_hosts.example.txt).
# Like .env it differs on every machine — the tunnel hostname here is not the
# tunnel hostname there — so only the example is tracked. The blanket *.txt rule
# above swallows the example too, hence the explicit un-ignore: without it the
# template never reaches the other machines, which is where it is actually read.
deploy/public_hosts.txt
!deploy/public_hosts.example.txt
*.env.example


# ---------------------------------------------------------------------------
# Research release policy (ISDS 2026 paper pipeline)
#
# The blanket *.json / *.csv / *.md rules above keep datasets and trained
# artifacts out of git, but they also swallow the research RECORDS the paper
# depends on. Those are re-included explicitly below.
#
#   commit  -> records that justify a claim (why legacy checkpoints are
#              invalid; the exact augmentation config the methodology cites)
#   ignore  -> anything regenerable from artifacts (result tables, determinism
#              logs, per-run audits, coverage dumps, pilot outputs)
# ---------------------------------------------------------------------------

# Generated / regenerable -> never committed
reports/experiment_results.csv
reports/experiment_results.tex
reports/determinism_report.json
reports/duplicate_audit.json
reports/duplicate_audit.md
reports/coverage_*.json
reports/pilot_*.json
reports/pilot_*.md
reports/quality_stats_*.json
reports/release_log_*.json
reports/determinism/

# Source files caught by the blanket *.txt rule
!backend/requirements.txt
!backend/requirements-dev.txt
!backend/realtime_service/requirements.txt
!processed/requirements-train.txt
!processed/requirements-realtime.txt

# Research records -> committed (negate the blanket rules above)
!docs/
!docs/**/*.md

# Lược đồ AS-BUILT. Luật `*.json` ở trên nuốt tệp này, nên nó CHƯA BAO GIỜ vào
# lịch sử — trong khi quyển luận văn trích dẫn nó kèm tên revision ("ảnh chụp
# 05bd8ea"). Một tạo tác được trích dẫn mà không tra lại được ở đúng revision ấy
# thì câu trích dẫn không có gì chống lưng, và đó đúng là điều mà chính tệp
# `ASBUILT_INVENTORY.md` cạnh nó cảnh báo. Bản kê đi kèm là `.md` nên vẫn được
# theo dõi — hai nửa của cùng một phép chụp mà chỉ một nửa vào git là trạng thái
# tệ nhất, vì nó trông như đã được lưu.
!docs/00-thesis/asbuilt/asbuilt_schema.json
!reports/checkpoint_validity.md
!reports/augmentation_contract.md
!reports/augmentation_contract.json
!release/
!release/*.json

# ---------------------------------------------------------------------------
# Working-tree residue. None of this is source; all of it appeared while
# preparing a deploy or debugging, and all of it showed up as untracked noise
# that a `git add -A` would have swept into a commit.
# ---------------------------------------------------------------------------

# Staging copy of the dataset made for the CTU deploy, plus its zip (48 MB).
# The dataset itself is already ignored via dataset/* — this is a second copy
# of the same thing under a different name, so the blanket rule misses it.
dataset_deploy/
dataset_deploy.zip

# Built frontend bundle dumped to the repo root while chasing a chunk-splitting
# problem. Regenerated by `npm run build` into frontend/dist/.
fe.tmp.js

# Runtime scratch written by the quality scorer inside the backend container.
# Data, not code; the container recreates it.
backend/dataset/

# Third-party tool state.
.grapuco/

# Timestamped hand-made backups (config/legacy_signer_mapping.json.bak_*, ...).
# The rescue copy from 2026-07-27 did its job — the live file is now tracked and
# is a strict superset of it — so the copies no longer need to be kept.
*.bak_*
*.bak

# Sao lưu Postgres tự động (service `pg-backup`). Đây là dữ liệu sản xuất đã
# nén: hàng trăm MB mỗi bản, giữ 14 ngày. Không bao giờ vào git.
/backups/

# Báo cáo test do CI sinh — không commit
junit-*.xml

# Bản PDF đính kèm do Zotero xuất ra (26 MB). Danh mục `.bib` cạnh nó ĐƯỢC theo
# dõi vì đó mới là thứ quyển luận văn trích dẫn; các tệp PDF chỉ là bản sao của
# tài liệu đã xuất bản, tải lại được, và không nên nằm trong lịch sử git.
docs/00-thesis/SignBridge_Reference/files/

# Bản xuất Zotero đã bị chính người dùng đánh dấu KHÔNG DÙNG.
docs/00-thesis/SignBridge_Reference/*KHONG_DUNG*

# Thư mục làm việc của các lượt đo: vân tay mã nguồn, ảnh chụp mã, chứng cứ thô
# theo từng lượt chạy. Kết quả đã CÔNG BỐ nằm ở docs/00-thesis/MEASUREMENT_*,
# nên thư mục này là scratch chứ không phải hồ sơ.
.measurement/
*.bak2

# Bản nén của chính thư mục `docs/` (36 MB). Nó là bản sao, không phải nguồn:
# mọi thứ bên trong đã được theo dõi ở dạng tệp rời. Đưa vào lịch sử git thì
# mỗi lần nén lại sinh một blob 36 MB mới không khử trùng lặp được.
/docs.zip

# Bản Word do người khác gửi tới. Nội dung đã được chuyển vào các tệp Markdown
# của quyển; giữ bản nhị phân trong git thì không diff được và không ai biết
# bản nào mới hơn.
*.docx

# Cygwin/MSYS đổ stack khi một tiến trình con chết bất thường — rác, không phải mã.
*.stackdump

# PNG xuất từ .drawio — sinh lại được bằng docs/02-data/db/gen_erd.py + drawio-export.
# Nguồn là tệp .drawio, không phải ảnh.
docs/02-data/db/erd_png/

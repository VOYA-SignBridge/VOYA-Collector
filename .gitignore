# Dependencies
node_modules/
.venv/

# Build artifacts
dist/
.cache/
build/

# Environment files (never commit real secrets).
# Ignore .env and all variants (.env.local, .env.production, ...) but keep the
# committed templates (.env.example at any depth).
.env
.env.*
!.env.example
!*.env.example

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Log fileslog
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.pyc
*.pyo
*.pyd

# Git
.gitnexus/

# OS files
.DS_Store
Thumbs.db

# Database files
*.db
*.sqlite
*.sqlite3

# Temporary files
temp/
tmp/
*.tmp

# Video and model files
# ...but keep the directory itself tracked. Docker creates a missing bind-mount
# source as root:root, and the containers run as uid 1000 (appuser) — on Linux
# that makes /dataset unwritable and every upload fails. A committed .gitkeep
# means `git clone` creates the dir owned by the cloning user instead.
dataset/*
!dataset/.gitkeep
*.mp4
*.npz
*.npy
*.mov
*.avi

# Git
.git/

# Google Drive credentials
# Same reasoning as dataset/ above: keep the directory, never its contents
# (credentials.json / token.json stay out of git).
gdrive/*
!gdrive/.gitkeep

# Spreadsheet credentials
SsheetAPI/

#Trained Model
processed/train_utils/outputs
processed/analysis
*.json
processed/splits
*.csv

*.md
*.txt
# TLS certs (self-signed for HTTP/2; use a real cert in prod)
certs/*
!certs/.gitkeep

# SOT — private signing keys must NEVER be committed (public keys in
# app/sot/authorized_keys.json are fine; those are meant to be committed).
sot_private.key
*.key
.voya/
# ...but the public-key allowlist MUST be tracked (overrides the *.json rule
# above); it is the committed root of trust servers verify against.
!backend/app/sot/authorized_keys.json

# Local scratch dir for verification logs / throwaway compose overrides.
# Never part of a deploy.
_tmp/

# Database dumps. backup.sql and merge_data.sql were committed in 1be7f25 and
# each carried 6 real user emails plus their bcrypt password hashes, along with
# full users / user_profiles / refresh_tokens rows. Nothing in the repo reads
# them. A dump is production personal data, not fixture data — keep it out.
*.sql
!**/migrations/*.sql
!scripts/*.sql

# Postgres/Redis data directories. This compose uses NAMED volumes, so these
# should not appear in the repo at all — but an older setup (or a hand-run
# container) can leave one behind, and it then shows up as untracked noise that
# a careless `git clean -fd` would delete along with the database inside it.
postgres_data/
pgdata/
redis_data/

# Per-machine allowlist of public hostnames (see deploy/public_hosts.example.txt).
# Like .env it differs on every machine — the tunnel hostname here is not the
# tunnel hostname there — so only the example is tracked.
deploy/public_hosts.txt

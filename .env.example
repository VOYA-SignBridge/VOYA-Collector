# Nginx host port
NGINX_HTTP_PORT=80

# Frontend build-time API base URL.
# Leave EMPTY for production (same-origin relative paths, proxied by
# nginx.conf to the backend). Only set this to an absolute URL if the
# frontend is served from a different origin than the nginx gateway.
VITE_API_URL=

# Database
# REQUIRED: replace admin/admin with a strong password before deploying.
# Keep DATABASE_URL's credentials in sync with POSTGRES_USER/POSTGRES_PASSWORD.
DATABASE_URL=postgresql://admin:admin@postgres:5432/signdb
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_DB=signdb

# Redis
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Dataset
DATASET_ROOT=/dataset

# Processing
FEATURE_DIM=126
SEQ_LEN=60
STRIDE=2
FPS_TARGET=30
RESIZE_W=640
RESIZE_H=480
AUG_PER_SEQ=8
VIDEO_AUG_PER_SEQ=8
VIDEO_COMPLETENESS=0.8
SPEED_VARIANTS=1.0
MAX_SAMPLES_PER_CLASS=200

# Keypoint processing
CANONICALIZE_HANDS=1
CANONICALIZE_MIRROR=1
CARRY_FORWARD_MISSING=1
DEBUG_LOGGING=0
ENABLE_LIVE_AUG=1
ENABLE_LIVE_SMOOTHING=0
LIVE_COMPLETENESS=0.5

# Video Processing
VIDEO_SKIP_LEADING_NO_HAND=1
VIDEO_STOP_AFTER_NO_HAND_FRAMES=0

# Storage Configuration
STORAGE_DOWNLOAD_WORKERS=4
STORAGE_DOWNLOAD_TIMEOUT_SECONDS=120

# Upload Limits
MAX_UPLOAD_MB=1024
MAX_CAMERA_FRAMES=600

# Logging
LOG_LEVEL=INFO

# Google Drive
USE_GOOGLE_DRIVE=1
GOOGLE_DRIVE_CREDENTIALS=/gdrive/credentials.json
GOOGLE_DRIVE_TOKEN=/gdrive/token.json
GOOGLE_DRIVE_ROOT_FOLDER_ID=signbridge-storage
GOOGLE_SHEETS_LABELS_SPREADSHEET_ID=
GOOGLE_SHEETS_LABELS_SHEET_GID=0
GOOGLE_SHEETS_SAMPLES_SPREADSHEET_ID=
GOOGLE_SHEETS_SAMPLES_SHEET_GID=0

# CORS: comma-separated origin list. Do NOT use "*" — the SPA is served
# same-origin through the nginx gateway, so normal traffic never exercises CORS
# and an explicit list costs nothing while stopping a stray page from calling
# the API by XHR. Origins only (scheme://host[:port]) — no path, no trailing
# slash. An empty value falls back to "*", so always set it.
#   local  : http://localhost,http://127.0.0.1,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
#   server : https://your.public.host
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# --- Session cookies --------------------------------------------------------
# COOKIE_SECURE marks voya_access / voya_refresh / voya_auth / voya_csrf as
# Secure, so the browser only ever sends them over HTTPS. It defaults to 0 in
# code, which is required for http://localhost (browsers reject Secure cookies
# on a plain-HTTP origin) but is the WRONG value for any HTTPS deployment —
# leave it 0 for local work and set it to 1 on the server.
COOKIE_SECURE=0
# "lax" is right when the SPA and API share an origin through the gateway.
# Only relax to "none" (which also requires COOKIE_SECURE=1) for a genuine
# cross-site setup.
COOKIE_SAMESITE=lax
# Empty = host-only cookies, correct unless you deliberately share a session
# across subdomains.
COOKIE_DOMAIN=
# Sub-path the app is served under, e.g. /voya. Must match VITE_BASE_PATH or
# the refresh cookie's Path will not cover the refresh endpoint and sessions
# silently stop renewing.
COOKIE_PATH_PREFIX=
# SPA base path and API prefix — set both to the sub-path for a /voya-style
# deploy, leave empty when serving from the root.
VITE_BASE_PATH=
VITE_API_URL=

# Marks the runtime environment. Keep "production" on a deployed host.
APP_ENV=development

# --- Redis ------------------------------------------------------------------
# The Celery broker/result backend read CELERY_* above; these two are read
# directly by the rate limiter and the TTS cache.
REDIS_URL=redis://redis:6379/0
TTS_REDIS_URL=redis://redis:6379/0

# --- Login brute-force limits ----------------------------------------------
# Backend-side lockout, layered under nginx's coarse flood cap. Values match the
# defaults in rate_limit.py: 5 failures inside a 30-min window arm a 15-min lock.
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=1800
LOGIN_LOCK_SECONDS=900

# Grafana. Published on 127.0.0.1 only — reach it via an SSH tunnel, never the
# public NIC. GRAFANA_ADMIN_PASSWORD has no default: compose fails fast if unset
# rather than silently booting the dashboards with admin/admin. Note the value
# only seeds the account on FIRST start; an existing grafana_data volume keeps
# its old password (reset with `grafana cli admin reset-admin-password`).
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_A_REAL_PASSWORD
GRAFANA_HTTP_PORT=3000

# --- Host ports -------------------------------------------------------------
# Only the HOST side; container-internal ports are fixed. Change these if
# something already owns the port on the target machine.
NGINX_HTTP_PORT=80
# NGINX_HTTPS_PORT is unused: nginx.conf has no `listen 443 ssl` vhost and
# certs/ is empty, so compose deliberately does not map 443. Restore the vhost
# and the port mapping together if you terminate TLS at this gateway.
#NGINX_HTTPS_PORT=443
# :8000 proxies straight to the backend and :8001 is a plain "OK" probe —
# neither goes through the /voya routing or the gateway's limit_req zones, so
# both bind to loopback. Setting DEBUG_BIND_HOST=0.0.0.0 exposes an unthrottled
# backend to the network; keep it at 127.0.0.1.
NGINX_BACKEND_PORT=8000
NGINX_HEALTH_PORT=8001
DEBUG_BIND_HOST=127.0.0.1

# --- Stack identity ---------------------------------------------------------
# Compose otherwise derives the project name from the DIRECTORY name, so a clone
# into any other folder breaks promtail's project filter and Loki collects
# nothing. Pinned here so log collection does not depend on the folder name.
COMPOSE_PROJECT_NAME=voya-collector
# Prefix for container names (voya_backend, voya_worker, ...). To run a second
# stack on the same host, change BOTH of these plus the ports above; note that
# promtail only scrapes the project pinned in logging/promtail-config.yaml.
CONTAINER_PREFIX=voya

# Auth / JWT
# REQUIRED before production deploy: generate real random secrets, e.g.
#   python -c "import secrets; print(secrets.token_hex(32))"
# Do NOT deploy with the placeholder values below — they are public (in git).
SECRET_KEY=REPLACE_WITH_RANDOM_SECRET__DO_NOT_USE_IN_PRODUCTION
AUTH_TOKEN_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET__DO_NOT_USE_IN_PRODUCTION
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Idle session cap (minutes). Refresh token is rotated each use and lives this
# long since its last rotation, so a session idle this long is dead server-side.
# Pairs with the client-side inactivity logout (same value). 90 = 1h30.
REFRESH_TOKEN_EXPIRE_MINUTES=90
ALLOW_GUEST_UPLOAD=1
MIN_PASSWORD_LENGTH=8
ADMIN_USERNAME=superadmin
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# Forgot / reset password
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
# REQUIRED: change to the real public domain/IP of the school server —
# used to build password-reset links sent by email.
FRONTEND_BASE_URL=http://localhost:5173

# SMTP (leave SMTP_HOST empty to log reset links instead of sending email — dev only)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@voya-collector.local
SMTP_USE_TLS=1

# --- Container memory ceilings ---------------------------------------------
# These are CEILINGS, not reservations: Docker does not set the RAM aside, it
# only refuses to let a container exceed the number. Measured on the reference
# host the whole stack sits at ~0.94 GB idle and ~4.5 GB while training, so a
# higher ceiling costs nothing until something actually needs it.
#
# The defaults in docker-compose.prod.yml are sized for a 12 GB host and total
# ~11.2 GB; leave these unset there. On a larger machine, uncomment and tune.
#
# Reference profile for a 96 GB workstation that also runs other software
# (~35 GB genuinely free): totals ~19.6 GB of ceilings, so even if every service
# peaked at once ~15 GB stays free. trainer takes the largest share because
# training materializes the .npz dataset into host RAM — 3.05 GB measured for
# 1002 samples / 40 classes, and it scales with the dataset.
#TRAINER_MEM=8000m
#WORKER_MEM=4000m
#BACKEND_MEM=2500m
#POSTGRES_MEM=2000m
#REDIS_MEM=1000m
#REALTIME_MEM=1200m
#
# Windows only: the Docker Desktop WSL2 backend has its OWN memory cap, and a
# compose ceiling above it does nothing. Check what Docker actually has with
#   docker info --format '{{.MemTotal}}'
# and if it is below the total above, raise it in C:\Users\<you>\.wslconfig
#   [wsl2]
#   memory=32GB
# then run `wsl --shutdown` and restart Docker Desktop.

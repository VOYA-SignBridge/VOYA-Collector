# Frontend
VITE_API_URL=http://voya_nginx:80

# Database
DATABASE_URL=postgresql://user:password@postgres:5432/signdb
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=signdb
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin

# Redis
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Dataset
DATASET_ROOT=/dataset

# Processing
FEATURE_DIM=126
SEQ_LEN=60
STRIDE=2
FPS_TARGET=30
RESIZE_W=480
RESIZE_H=480
AUG_PER_SEQ=2
VIDEO_AUG_PER_SEQ=8
VIDEO_COMPLETENESS=0.4
SPEED_VARIANTS=1.0
MAX_SAMPLES_PER_CLASS=2000

# Keypoint processing
CANONICALIZE_HANDS=1
CANONICALIZE_MIRROR=1
CARRY_FORWARD_MISSING=1
DEBUG_LOGGING=0

# R2 Setup
USE_OBJECT_STORAGE=1
R2_ENDPOINT=<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY=your-r2-access-key
R2_SECRET_KEY=your-r2-secret-key
R2_BUCKET_NAME=sign-dataset
# ============================================================================
# VOYA-Collector Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your values.
# IMPORTANT: Database credentials must be consistent across all locations.

# Frontend Configuration
# ============================================================================
# For browser access from your machine: http://localhost:8000
# For production: https://yourdomain.com
NGINX_HTTP_PORT=8080
VITE_API_URL=http://localhost:8000

# Backend API Configuration
# ============================================================================
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000

# Database Configuration (CRITICAL)
# ============================================================================
# WARNING: All database credentials must be CONSISTENT
# Do not use different usernames or passwords in different locations
POSTGRES_USER=signuser
POSTGRES_PASSWORD=signpass
POSTGRES_DB=signdb
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://signuser:signpass@postgres:5432/signdb
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin123

# Redis Configuration
# ============================================================================
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Dataset Configuration
# ============================================================================
DATASET_ROOT=/dataset

# Processing Configuration
# ============================================================================
FEATURE_DIM=126
SEQ_LEN=60
STRIDE=2
FPS_TARGET=30
RESIZE_W=640
RESIZE_H=480
AUG_PER_SEQ=8
VIDEO_AUG_PER_SEQ=0
VIDEO_COMPLETENESS=0.8
SPEED_VARIANTS=1.0,1.2,0.8
MAX_SAMPLES_PER_CLASS=80

# Keypoint Processing
# ============================================================================
CANONICALIZE_HANDS=1
CANONICALIZE_MIRROR=1
CARRY_FORWARD_MISSING=1
DEBUG_LOGGING=0
ENABLE_LIVE_AUG=1
ENABLE_LIVE_SMOOTHING=0
LIVE_COMPLETENESS=0.5

# Video Processing
# ============================================================================
VIDEO_SKIP_LEADING_NO_HAND=1
VIDEO_STOP_AFTER_NO_HAND_FRAMES=0

# MinIO (S3-compatible) Configuration
# ============================================================================
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=sign-dataset
USE_MINIO=1

# Cloudinary Configuration (optional cloud backup)
# ============================================================================
# Get your credentials at https://cloudinary.com/
# Free account - 25 GB monthly bandwidth, 10 GB storage
CLOUDINARY_ENABLED=1
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_UPLOAD_PRESET=optional_unsigned_preset
CLOUDINARY_TIMEOUT_SECONDS=60
CLOUDINARY_DEBUG_RESPONSES=0

# Storage Configuration
# ============================================================================
STORAGE_DOWNLOAD_WORKERS=4
STORAGE_DOWNLOAD_TIMEOUT_SECONDS=120

# Upload Limits
# ============================================================================
MAX_UPLOAD_MB=1024
MAX_CAMERA_FRAMES=600

# Logging Configuration
# ============================================================================
LOG_LEVEL=INFO


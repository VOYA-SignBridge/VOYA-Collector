  training_jobs [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#333333">
      <TR><TD COLSPAN="3" BGCOLOR="#E8E8E8" ALIGN="CENTER"><B>training_jobs</B></TD></TR>

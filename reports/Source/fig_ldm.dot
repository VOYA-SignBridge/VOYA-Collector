      <TR><TD ALIGN="LEFT"><FONT COLOR="#555555">TEXT</FONT></TD><TD PORT="upload_uid" ALIGN="LEFT"><B>upload_uid</B></TD><TD ALIGN="CENTER"><FONT COLOR="#555555">PK</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT COLOR="#555555">TEXT</FONT></TD><TD PORT="class_uid" ALIGN="LEFT">class_uid</TD><TD ALIGN="CENTER"> </TD></TR>
      <TR><TD ALIGN="LEFT"><FONT COLOR="#555555">TEXT</FONT></TD><TD PORT="slug" ALIGN="LEFT">slug</TD><TD ALIGN="CENTER"> </TD></TR>
      <TR><TD ALIGN="LEFT"><FONT COLOR="#555555">TEXT</FONT></TD><TD PORT="label_original" ALIGN="LEFT">label_original</TD><TD ALIGN="CENTER"> </TD></TR>
      <TR><TD ALIGN="LEFT"><FONT COLOR="#555555">TEXT</FONT></TD><TD PORT="language" ALIGN="LEFT">language</TD><TD ALIGN="CENTER"> </TD></TR>
      <TR><TD ALIGN="LEFT"><FONT COLOR="#555555">TEXT</FONT></TD><TD PORT="dialect" ALIGN="LEFT">dialect</TD><TD ALIGN="CENTER"> </TD></TR>
      <TR><TD ALIGN="LEFT"><FONT COLOR="#555555">TEXT</FONT></TD><TD PORT="source_type" ALIGN="LEFT">source_type</TD><TD ALIGN="CENTER"> </TD></TR>
      <TR><TD ALIGN="LEFT"><FONT COLOR="#555555">TEXT</FONT></TD><TD PORT="user_id" ALIGN="LEFT">user_id</TD><TD ALIGN="CENTER"> </TD></TR>
      <TR><TD ALIGN="LEFT"><FONT COLOR="#555555">UUID</FONT></TD><TD PORT="auth_user_id" ALIGN="LEFT"><B>auth_user_id</B></TD><TD ALIGN="CENTER"><FONT COLOR="#555555">FK set null</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT COLOR="#555555">TEXT</FONT></TD><TD PORT="session_id" ALIGN="LEFT">session_id</TD><TD ALIGN="CENTER"> </TD></TR>
      <TR><TD ALIGN="LEFT"><FONT COLOR="#555555">TEXT</FONT></TD><TD PORT="original_filename" ALIGN="LEFT">original_filename</TD><TD ALIGN="CENTER"> </TD></TR>
      <TR><TD ALIGN="LEFT"><FONT COLOR="#555555">TEXT</FONT></TD><TD PORT="local_path" ALIGN="LEFT">local_path</TD><TD ALIGN="CENTER"> </TD></TR>
      <TR><TD ALIGN="LEFT"><FONT COLOR="#555555">TEXT</FONT></TD><TD PORT="storage_key" ALIGN="LEFT">storage_key</TD><TD ALIGN="CENTER"> </TD></TR>
      <TR><TD ALIGN="LEFT"><FONT COLOR="#555555">TEXT</FONT></TD><TD PORT="storage_url" ALIGN="LEFT">storage_url</TD><TD ALIGN="CENTER"> </TD></TR>
      <TR><TD ALIGN="LEFT"><FONT COLOR="#555555">TIMESTAMPTZ</FONT></TD><TD PORT="created_at" ALIGN="LEFT">created_at</TD><TD ALIGN="CENTER"> </TD></TR>
      <TR><TD ALIGN="LEFT"><FONT COLOR="#555555">TIMESTAMPTZ</FONT></TD><TD PORT="updated_at" ALIGN="LEFT">updated_at</TD><TD ALIGN="CENTER"> </TD></TR>
      <TR><TD ALIGN="LEFT"><FONT COLOR="#555555">TIMESTAMPTZ</FONT></TD><TD PORT="deleted_at" ALIGN="LEFT">deleted_at</TD><TD ALIGN="CENTER"> </TD></TR>
    </TABLE>>];


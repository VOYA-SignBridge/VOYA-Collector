  users [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#333333">
      <TR><TD COLSPAN="3" BGCOLOR="#E8E8E8" ALIGN="CENTER"><B>users</B></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT COLOR="#555555">UUID</FONT></TD><TD PORT="id" ALIGN="LEFT"><B>id</B></TD><TD ALIGN="CENTER"><FONT COLOR="#555555">PK</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT COLOR="#555555">TEXT</FONT></TD><TD PORT="username" ALIGN="LEFT"><B>username</B></TD><TD ALIGN="CENTER"><FONT COLOR="#555555">UK</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT COLOR="#555555">TEXT</FONT></TD><TD PORT="email" ALIGN="LEFT"><B>email</B></TD><TD ALIGN="CENTER"><FONT COLOR="#555555">UK</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT COLOR="#555555">TEXT</FONT></TD><TD PORT="password_hash" ALIGN="LEFT">password_hash <FONT COLOR="#777777">*</FONT></TD><TD ALIGN="CENTER"> </TD></TR>
      <TR><TD ALIGN="LEFT"><FONT COLOR="#555555">BOOLEAN</FONT></TD><TD PORT="is_active" ALIGN="LEFT">is_active <FONT COLOR="#777777">*</FONT></TD><TD ALIGN="CENTER"> </TD></TR>
      <TR><TD ALIGN="LEFT"><FONT COLOR="#555555">BOOLEAN</FONT></TD><TD PORT="is_admin" ALIGN="LEFT">is_admin <FONT COLOR="#777777">*</FONT></TD><TD ALIGN="CENTER"> </TD></TR>
      <TR><TD ALIGN="LEFT"><FONT COLOR="#555555">TIMESTAMPTZ</FONT></TD><TD PORT="created_at" ALIGN="LEFT">created_at <FONT COLOR="#777777">*</FONT></TD><TD ALIGN="CENTER"> </TD></TR>
    </TABLE>>];

  // Declared foreign keys, enforced by PostgreSQL
  users:id:w -> password_reset_tokens:user_id:w [arrowtail=teetee, arrowhead=crowodot];
  users:id:w -> raw_uploads:auth_user_id:w [arrowtail=teeodot, arrowhead=crowodot];
  users:id:w -> refresh_tokens:user_id:w [arrowtail=teetee, arrowhead=crowodot];
  users:id:w -> samples:auth_user_id:w [arrowtail=teeodot, arrowhead=crowodot];
  users:id:w -> training_jobs:auth_user_id:w [arrowtail=teeodot, arrowhead=crowodot];

  // Logical relations with no FK constraint in the schema
  classes:class_uid:w -> samples:class_uid:w [style=dashed, color="#777777", arrowtail=teeodot, arrowhead=crowodot];
  signers:signer_id:w -> samples:signer_id:w [style=dashed, color="#777777", arrowtail=teeodot, arrowhead=crowodot];
  classes:class_uid:w -> raw_uploads:class_uid:w [style=dashed, color="#777777", arrowtail=teeodot, arrowhead=crowodot];
  training_jobs:job_id:w -> training_metrics:job_id:w [style=dashed, color="#777777", arrowtail=teetee, arrowhead=crowodot];
}

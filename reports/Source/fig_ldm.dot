digraph ldm {
  graph [rankdir=TB, splines=polyline, nodesep=0.65, ranksep=0.95,
         bgcolor="white", fontname="Times New Roman,", fontsize=13];
  node  [shape=plaintext, fontname="Times New Roman,", fontsize=12];
  edge  [color="#333333", penwidth=1.1, arrowsize=1.0, dir=both];

  classes [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#333333">
      <TR><TD COLSPAN="3" BGCOLOR="#E8E8E8" ALIGN="CENTER"><B>classes</B></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT COLOR="#555555">TEXT</FONT></TD><TD PORT="class_uid" ALIGN="LEFT"><B>class_uid</B></TD><TD ALIGN="CENTER"><FONT COLOR="#555555">PK</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT COLOR="#555555">INTEGER</FONT></TD><TD PORT="class_idx" ALIGN="LEFT">class_idx</TD><TD ALIGN="CENTER"> </TD></TR>
      <TR><TD ALIGN="LEFT"><FONT COLOR="#555555">TEXT</FONT></TD><TD PORT="slug" ALIGN="LEFT">slug</TD><TD ALIGN="CENTER"> </TD></TR>
      <TR><TD ALIGN="LEFT"><FONT COLOR="#555555">TEXT</FONT></TD><TD PORT="label_original" ALIGN="LEFT">label_original</TD><TD ALIGN="CENTER"> </TD></TR>
      <TR><TD ALIGN="LEFT"><FONT COLOR="#555555">TEXT</FONT></TD><TD PORT="language" ALIGN="LEFT">language</TD><TD ALIGN="CENTER"> </TD></TR>
      <TR><TD ALIGN="LEFT"><FONT COLOR="#555555">TEXT</FONT></TD><TD PORT="dialect" ALIGN="LEFT">dialect</TD><TD ALIGN="CENTER"> </TD></TR>
      <TR><TD ALIGN="LEFT"><FONT COLOR="#555555">BOOLEAN</FONT></TD><TD PORT="is_common_global" ALIGN="LEFT">is_common_global</TD><TD ALIGN="CENTER"> </TD></TR>
      <TR><TD ALIGN="LEFT"><FONT COLOR="#555555">BOOLEAN</FONT></TD><TD PORT="is_common_language" ALIGN="LEFT">is_common_language</TD><TD ALIGN="CENTER"> </TD></TR>
      <TR><TD ALIGN="LEFT"><FONT COLOR="#555555">TEXT</FONT></TD><TD PORT="folder_name" ALIGN="LEFT">folder_name</TD><TD ALIGN="CENTER"> </TD></TR>
      <TR><TD ALIGN="LEFT"><FONT COLOR="#555555">TIMESTAMPTZ</FONT></TD><TD PORT="created_at" ALIGN="LEFT">created_at</TD><TD ALIGN="CENTER"> </TD></TR>
      <TR><TD ALIGN="LEFT"><FONT COLOR="#555555">TIMESTAMPTZ</FONT></TD><TD PORT="migrated_at" ALIGN="LEFT">migrated_at</TD><TD ALIGN="CENTER"> </TD></TR>
      <TR><TD ALIGN="LEFT"><FONT COLOR="#555555">TIMESTAMPTZ</FONT></TD><TD PORT="deleted_at" ALIGN="LEFT">deleted_at</TD><TD ALIGN="CENTER"> </TD></TR>
      <TR><TD ALIGN="LEFT"><FONT COLOR="#555555">INTEGER</FONT></TD><TD PORT="hands_required" ALIGN="LEFT">hands_required</TD><TD ALIGN="CENTER"> </TD></TR>
      <TR><TD ALIGN="LEFT"><FONT COLOR="#555555">TEXT</FONT></TD><TD PORT="semantic_label" ALIGN="LEFT">semantic_label</TD><TD ALIGN="CENTER"> </TD></TR>
      <TR><TD ALIGN="LEFT"><FONT COLOR="#555555">TEXT</FONT></TD><TD PORT="vocabulary_scope" ALIGN="LEFT">vocabulary_scope</TD><TD ALIGN="CENTER"> </TD></TR>
      <TR><TD ALIGN="LEFT"><FONT COLOR="#555555">TEXT</FONT></TD><TD PORT="recognition_profile" ALIGN="LEFT">recognition_profile</TD><TD ALIGN="CENTER"> </TD></TR>
      <TR><TD ALIGN="LEFT"><FONT COLOR="#555555">TEXT</FONT></TD><TD PORT="vocabulary_group" ALIGN="LEFT">vocabulary_group</TD><TD ALIGN="CENTER"> </TD></TR>
      <TR><TD ALIGN="LEFT"><FONT COLOR="#555555">TEXT</FONT></TD><TD PORT="collection_campaign" ALIGN="LEFT">collection_campaign</TD><TD ALIGN="CENTER"> </TD></TR>
      <TR><TD ALIGN="LEFT"><FONT COLOR="#555555">BOOLEAN</FONT></TD><TD PORT="is_active" ALIGN="LEFT">is_active</TD><TD ALIGN="CENTER"> </TD></TR>
      <TR><TD ALIGN="LEFT"><FONT COLOR="#555555">TEXT</FONT></TD><TD PORT="motion_type" ALIGN="LEFT">motion_type</TD><TD ALIGN="CENTER"> </TD></TR>
    </TABLE>>];

  google_sheets_sync_status [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#333333">
      <TR><TD COLSPAN="3" BGCOLOR="#E8E8E8" ALIGN="CENTER"><B>google_sheets_sync_status</B></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT COLOR="#555555">INTEGER</FONT></TD><TD PORT="id" ALIGN="LEFT"><B>id</B></TD><TD ALIGN="CENTER"><FONT COLOR="#555555">PK</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(50)</FONT></TD><TD PORT="table_name" ALIGN="LEFT"><B>table_name</B></TD><TD ALIGN="CENTER"><FONT COLOR="#555555">UK</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(100)</FONT></TD><TD PORT="current_spreadsheet_id" ALIGN="LEFT">current_spreadsheet_id <FONT COLOR="#777777">*</FONT></TD><TD ALIGN="CENTER"> </TD></TR>
      <TR><TD ALIGN="LEFT"><FONT COLOR="#555555">INTEGER</FONT></TD><TD PORT="current_sheet_index" ALIGN="LEFT">current_sheet_index <FONT COLOR="#777777">*</FONT></TD><TD ALIGN="CENTER"> </TD></TR>
      <TR><TD ALIGN="LEFT"><FONT COLOR="#555555">INTEGER</FONT></TD><TD PORT="current_data_rows" ALIGN="LEFT">current_data_rows <FONT COLOR="#777777">*</FONT></TD><TD ALIGN="CENTER"> </TD></TR>
      <TR><TD ALIGN="LEFT"><FONT COLOR="#555555">INTEGER</FONT></TD><TD PORT="max_rows_per_sheet" ALIGN="LEFT">max_rows_per_sheet <FONT COLOR="#777777">*</FONT></TD><TD ALIGN="CENTER"> </TD></TR>
      <TR><TD ALIGN="LEFT"><FONT COLOR="#555555">TIMESTAMPTZ</FONT></TD><TD PORT="updated_at" ALIGN="LEFT">updated_at</TD><TD ALIGN="CENTER"> </TD></TR>
    </TABLE>>];

  password_reset_tokens [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#333333">
      <TR><TD COLSPAN="3" BGCOLOR="#E8E8E8" ALIGN="CENTER"><B>password_reset_tokens</B></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT COLOR="#555555">TEXT</FONT></TD><TD PORT="token_hash" ALIGN="LEFT"><B>token_hash</B></TD><TD ALIGN="CENTER"><FONT COLOR="#555555">PK</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT COLOR="#555555">UUID</FONT></TD><TD PORT="user_id" ALIGN="LEFT"><B>user_id</B></TD><TD ALIGN="CENTER"><FONT COLOR="#555555">FK cascade</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT COLOR="#555555">TIMESTAMPTZ</FONT></TD><TD PORT="expires_at" ALIGN="LEFT">expires_at <FONT COLOR="#777777">*</FONT></TD><TD ALIGN="CENTER"> </TD></TR>
      <TR><TD ALIGN="LEFT"><FONT COLOR="#555555">TIMESTAMPTZ</FONT></TD><TD PORT="used_at" ALIGN="LEFT">used_at</TD><TD ALIGN="CENTER"> </TD></TR>
      <TR><TD ALIGN="LEFT"><FONT COLOR="#555555">TIMESTAMPTZ</FONT></TD><TD PORT="created_at" ALIGN="LEFT">created_at <FONT COLOR="#777777">*</FONT></TD><TD ALIGN="CENTER"> </TD></TR>
    </TABLE>>];


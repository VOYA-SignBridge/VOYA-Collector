# DEV: LEAVE VITE_API_URL EMPTY/UNSET.
# The vite dev server (localhost:5173) proxies /api, /auth, /upload, ... to the
# backend (see vite.config.ts) so requests stay SAME-ORIGIN and the httpOnly
# auth cookies work. Setting an absolute URL here makes the browser call the
# backend CROSS-ORIGIN, and cookie login breaks (CORS allow_credentials=False).
# Only set this for special deployments where nginx injects window.__ENV__.
#VITE_API_URL=

VITE_MIRROR_PREVIEW=1
VITE_SWAP_HANDEDNESS=1
VITE_DEBUG_HANDS=1

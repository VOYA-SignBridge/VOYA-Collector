# ════════════════════════════════════════════════════════════════
# V2 stack environment template (erd_v2_unified_design.md §12.1)
# Copy to .env and adjust. NEVER commit a real .env.
# The app REFUSES TO START if ENVIRONMENT=dev but an id below matches
# PROD_RESOURCE_IDS (guard fail-fast in app/core/config.py).
# ════════════════════════════════════════════════════════════════
ENVIRONMENT=dev

# Comma-separated ids of PRODUCTION resources (leave filled on every
# machine — it is what lets the guard recognise a leaked prod config).
PROD_RESOURCE_IDS=

# ── PostgreSQL v2 (docker-compose.dev.yml publishes 5433) ─────────
V2_POSTGRES_USER=signbridge
V2_POSTGRES_PASSWORD=signbridge
V2_POSTGRES_HOST=localhost
V2_POSTGRES_PORT=5433
V2_POSTGRES_DB=signbridge_v2

# ── Redis v2 ───────────────────────────────────────────────────────
V2_REDIS_URL=redis://localhost:6380/0

# ── MinIO (dev console: http://localhost:9101) ────────────────────
MINIO_ENDPOINT=localhost:9100
MINIO_ACCESS_KEY=signbridge
MINIO_SECRET_KEY=signbridge-dev
MINIO_SECURE=false

# ── Google integrations — OFF in dev (§12.1) ──────────────────────
GDRIVE_ENABLED=false
SHEETS_ENABLED=false
GDRIVE_ROOT_FOLDER_ID=
SHEETS_SERVICE_ACCOUNT_FILE=

# ── Auth / crypto (MUST be overridden in prod) ────────────────────
JWT_SECRET_KEY=dev-jwt-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
USER_REF_PEPPER=dev-user-ref-pepper-change-me

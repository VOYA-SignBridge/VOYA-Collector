{
  "title": "VOYA System Monitor",
  "uid": "voya-sys-mon",
  "tags": [ "voya", "system" ],
  "timezone": "browser",
  "panels": [
    {
      "type": "stat",
      "title": "Active In-Flight Requests",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "datasource": {"uid": "prometheus"},
      "targets": [
        { "expr": "sum(http_requests_in_progress)" }
      ]
    },
    {
      "type": "timeseries",
      "title": "CPU Usage (%)",
      "gridPos": { "x": 4, "y": 0, "w": 10, "h": 6 },
      "datasource": {"uid": "prometheus"},
      "targets": [
        { "expr": "voya_cpu_usage_percent", "refId": "A" }
      ]
    },
    {
      "type": "timeseries",
      "title": "RAM Usage (MB)",
      "gridPos": { "x": 14, "y": 0, "w": 10, "h": 6 },
      "datasource": {"uid": "prometheus"},
      "targets": [
        { "expr": "voya_ram_used_mb", "refId": "A", "legendFormat": "Used" },
        { "expr": "voya_ram_total_mb", "refId": "B", "legendFormat": "Total" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Request Rate (req/s)",
      "gridPos": { "x": 0, "y": 6, "w": 16, "h": 8 },
      "datasource": {"uid": "prometheus"},
      "targets": [
        { "expr": "sum(rate(http_requests_total[1m])) by (path)", "refId": "A", "legendFormat": "{{path}}" }
      ]
    },
    {
      "type": "piechart",
      "title": "Errors by Status Code",
      "gridPos": { "x": 16, "y": 6, "w": 8, "h": 8 },
      "datasource": {"uid": "prometheus"},
      "targets": [
        { "expr": "sum(rate(http_requests_total{status=~\"[45].*\"}[5m])) by (status)", "refId": "A", "legendFormat": "HTTP {{status}}" }
      ],
      "options": {
        "pieType": "donut",
        "displayLabels": ["percent", "name"]
      }
    },
    {
      "type": "timeseries",
      "title": "Latency P95 (Seconds)",
      "gridPos": { "x": 0, "y": 14, "w": 14, "h": 8 },
      "datasource": {"uid": "prometheus"},
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le, path))", "refId": "A", "legendFormat": "P95 {{path}}" },
        { "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket[5m])) by (le, path))", "refId": "B", "legendFormat": "P99 {{path}}" }
      ]
    },
    {
      "type": "table",
      "title": "Top 5 Slowest Endpoints (Avg Latency)",
      "gridPos": { "x": 14, "y": 14, "w": 10, "h": 8 },
      "datasource": {"uid": "prometheus"},
      "targets": [
        { 
          "expr": "topk(5, sum(rate(http_request_duration_seconds_sum[5m])) by (path) / sum(rate(http_request_duration_seconds_count[5m])) by (path))", 
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ]
    },
    {
      "type": "logs",
      "title": "Backend Logs (Loki)",
      "gridPos": { "x": 0, "y": 22, "w": 24, "h": 12 },
      "datasource": {"uid": "loki"},
      "targets": [
        { "expr": "{container=\"voya_backend\"}", "refId": "A" }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true
      }
    }
  ],
  "schemaVersion": 38,
  "version": 3
}
